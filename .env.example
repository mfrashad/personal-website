# ==================================
# PERSONAL WEBSITE - ENVIRONMENT VARIABLES
# ==================================
# Copy this file to .env and fill in your actual values
# cp .env.example .env

# ==================================
# SITE CONFIGURATION
# ==================================
# Your website domain (update when deploying)
PUBLIC_SITE_URL=https://www.mfrashad.com

# ==================================
# EMAIL SERVICE (OPTIONAL)
# ==================================
# Formspree - For the contact form (use the form ID URL format)
# Get your endpoint at: https://formspree.io → create a form → copy URL like https://formspree.io/f/xxxxxxxx
PUBLIC_FORMSPREE_URL=https://formspree.io/f/your_form_id_here

# For server-side email functionality
# Sign up at: https://resend.com
# RESEND_API_KEY=re_your_api_key_here

# ==================================
# ANALYTICS (OPTIONAL)
# ==================================
# PostHog - Product analytics
# Get your project API key at: https://us.posthog.com/settings/project
PUBLIC_POSTHOG_KEY=phc_your_project_api_key_here

# ==================================
# EXTERNAL INTEGRATIONS (OPTIONAL)
# ==================================

# Cleve API - For digital garden writings
# Your personal writings from Cleve (get your Convex URL from the Cleve dashboard)
CLEVE_API_KEY=clv_your_api_key_here
PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
CLEVE_PROFILE_SLUG=your_cleve_slug

# GitHub API - For digital garden feature (alternative to Cleve)
# Get token at: https://github.com/settings/tokens
# GITHUB_TOKEN=ghp_your_github_token_here

# Raindrop.io - For bookmarks feature  
# Get token at: https://app.raindrop.io/settings/integrations
# RAINDROP_TOKEN=your_raindrop_token_here

# Hardcover - For books/media feature
# Get token at: https://hardcover.app/account/api
# HARDCOVER_API_KEY=your_hardcover_api_key_here

# Pexels - For placeholder images
# Get API key at: https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here

# ==================================
# LETTERBOXD (MOVIES) & TMDB
# ==================================
# The movies page scrapes data from your public Letterboxd profile
# Update the username in /src/pages/movies.astro
# TMDB API is used to fetch high-quality movie posters
# Get your API key at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# ==================================
# WEBMENTIONS (NEW)
# ==================================
# Webmention.io integration for social interactions
# Sign up at: https://webmention.io
# Add your domain and verify ownership
# Then create an API token
WEBMENTION_IO_TOKEN=your_webmention_io_token_here
PUBLIC_WEBMENTION_IO_DOMAIN=www.mfrashad.com

# ==================================
# NOTES
# ==================================
# - Not all variables are required
# - The site works perfectly without any .env variables
# - Only add variables for features you actually want to use
# - Never commit your .env file to git (it's in .gitignore)


# ==================================
# TURSO (Guestbook/Postcards)
# ==================================
# Create a database at https://turso.tech and get credentials
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
