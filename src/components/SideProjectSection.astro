---
import { projects } from 'src/content/projects';
import ProjectItem from './ProjectItem.astro';
import SectionContent from './SectionContent.astro';
import NewSliderItem from './newSlider/NewSliderItem.astro';
import NewSlider from './newSlider/NewSlider.astro';
import SpriteCharacter from './animations/SpriteCharacter';
import { SPRITES } from '../data/sprites';
---

<div>
    <SectionContent title="Projects">
        <SpriteCharacter config={SPRITES.coding_at_computer} scale={0.35} slot="icon" client:visible />
        A collection of things I've built, from side projects to full products.
    </SectionContent>
    <NewSlider>
        {
            projects.map((project, index) => (
                <NewSliderItem
                    classes="py-3"
                    largeFraction={3}
                    mediumFraction={2.5}
                    smallFraction={1.25}
                >
                    <ProjectItem
                        bgColor={project.bgColor}
                        href={project.href}
                        title={project.title}
                        description={project.description}
                        labels={project.labels}
                        year={project.year}
                        logo={project.logo}
                        logoWidth={project.logoWidth}
                        customOpenString={project.customOpenString}
                        comingSoon={project.comingSoon}
                    />
                </NewSliderItem>
            ))
        }
    </NewSlider>
</div>
