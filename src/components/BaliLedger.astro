---
// Interactive cost explorer for the Bali trip post.
// Generated by trip/build.py — edit that, not this file.
// Styles are is:global and namespaced under .blx-root because the JS builds
// elements at runtime, which Astro's scoped styles would not reach.
---

<div class="blx-root">

  <div class="blx-modebar" role="group" aria-label="Trip party size">
    <span class="blx-lbl">Costed for</span>
    <button type="button" class="blx-mode" data-mode="solo" aria-pressed="true">🧍 Going solo</button>
    <button type="button" class="blx-mode" data-mode="duo" aria-pressed="false">👥 Two people sharing</button>
    <span class="blx-modenote" id="blxModeNote"></span>
  </div>

  <div class="blx-tiles">
    <div class="blx-tile"><span class="blx-lbl">Total per person</span><span class="blx-v" id="blxTotal"></span></div>
    <div class="blx-tile"><span class="blx-lbl">Per day</span><span class="blx-v" id="blxPerDay"></span></div>
    <div class="blx-tile"><span class="blx-lbl">In rupiah</span><span class="blx-v" id="blxIdr"></span></div>
    <div class="blx-tile"><span class="blx-lbl">Nights · days</span><span class="blx-v">11 <small>· 12</small></span></div>
  </div>

  <div class="blx-charts">
    <div class="blx-card">
      <h3 class="blx-h3">Where the money goes</h3>
      <p class="blx-cap" id="blxDonutCap"></p>
      <div class="blx-donutwrap">
        <svg id="blxDonut" viewBox="0 0 180 180" width="168" height="168" role="img" aria-labelledby="blxDonutT">
          <title id="blxDonutT">Share of spending by category</title>
        </svg>
        <ul class="blx-legend" id="blxLegend"></ul>
      </div>
    </div>
    <div class="blx-card">
      <h3 class="blx-h3">Day by day</h3>
      <p class="blx-cap">Each column is one day, stacked by category. Click a column to filter to it.</p>
      <div class="blx-cols" id="blxCols"></div>
      <div class="blx-colx" id="blxColx"></div>
    </div>
  </div>

  <div class="blx-filters">
    <div class="blx-frow" id="blxFCat"><span class="blx-lbl">Category</span></div>
    <div class="blx-frow" id="blxFDay"><span class="blx-lbl">Day</span></div>
    <div class="blx-summary">
      <b id="blxSumMyr"></b>
      <span id="blxSumIdr" class="blx-num"></span>
      <span id="blxSumCnt"></span>
      <span id="blxSumShare"></span>
      <button class="blx-btn blx-reset" id="blxReset" type="button">↺ Clear</button>
    </div>
  </div>

  <div id="blxList"></div>

  <h3 class="blx-h3 blx-sect">Every night</h3>
  <div class="blx-scroll">
    <table class="blx-table">
      <thead><tr><th>Where</th><th>Nights</th><th class="blx-r">Per night</th><th class="blx-r">Total</th></tr></thead>
      <tbody id="blxStays"></tbody>
      <tfoot><tr><td>Eleven nights</td><td></td><td class="blx-r" id="blxStayAvg"></td><td class="blx-r" id="blxStayTot"></td></tr></tfoot>
    </table>
  </div>
  <p class="blx-note" id="blxStayNote"></p>

</div>

<style is:global>
  .blx-root{
    /* Fills the article column. No negative-margin breakout: the blog article is
       left-aligned (lg:mx-0), not centred, so a symmetric breakout runs off-screen. */
    width: 100%;
    max-width: 100%;
    margin-block: 2.5rem;

    --blx-bg: var(--color-bg-primary, #fff);
    --blx-bg2: var(--color-bg-secondary, #f1f5f9);
    --blx-bg3: var(--color-bg-tertiary, #e2e8f0);
    --blx-ink: var(--color-text-body, rgba(0,0,0,.9));
    --blx-mut: var(--color-text-muted, rgba(0,0,0,.6));
    --blx-sub: var(--color-text-subtle, rgba(0,0,0,.4));
    --blx-line: var(--color-border-default, rgba(0,0,0,.1));
    --blx-line2: var(--color-border-emphasis, rgba(0,0,0,.3));
    --blx-accent: #3F73D6;

    --blx-act:#2E9E6B; --blx-stay:#3F73D6; --blx-food:#D95F4E;
    --blx-trans:#8C72E0; --blx-misc:#9A7A00;

    --blx-sans: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    --blx-mono: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;

    font-family: var(--blx-sans);
    color: var(--blx-ink);
    font-size: 15px;
    line-height: 1.55;
  }
  .dark .blx-root{
    --blx-accent:#5D87E4;
    --blx-act:#12A876; --blx-stay:#5D87E4; --blx-food:#DE6A4E;
    --blx-trans:#9179E9; --blx-misc:#98861B;
  }
  .blx-root *{box-sizing:border-box}
  .blx-root :focus-visible{outline:2px solid var(--blx-accent); outline-offset:2px; border-radius:4px}
  .blx-root .blx-lbl{
    font-size:10.5px; font-weight:700; letter-spacing:.1em; text-transform:uppercase;
    color:var(--blx-sub); margin:0;
  }
  .blx-root .blx-num{font-family:var(--blx-mono); font-variant-numeric:tabular-nums}
  .blx-root .blx-h3{
    font-family:var(--blx-sans); font-size:15px; font-weight:650; margin:0 0 2px;
    color:var(--blx-ink); letter-spacing:-.01em;
  }
  .blx-root .blx-sect{margin-top:2.25rem; font-size:16px}
  .blx-root .blx-cap{font-size:12.5px; color:var(--blx-sub); margin:0 0 16px}
  .blx-root .blx-note{font-size:13.5px; color:var(--blx-mut); margin:12px 0 0}

  /* mode toggle */
  .blx-root .blx-modebar{
    display:flex; flex-wrap:wrap; align-items:center; gap:8px;
    padding:12px 14px; background:var(--blx-bg2); border-radius:10px;
  }
  .blx-root .blx-mode{
    font-family:var(--blx-sans); font-size:13px; font-weight:600; cursor:pointer;
    border:1px solid var(--blx-line); background:var(--blx-bg); color:var(--blx-mut);
    border-radius:999px; padding:6px 14px; line-height:1.4;
    transition:background .12s, color .12s, border-color .12s;
  }
  .blx-root .blx-mode:hover{color:var(--blx-ink)}
  .blx-root .blx-mode[aria-pressed="true"]{
    background:var(--blx-ink); color:var(--blx-bg); border-color:var(--blx-ink);
  }
  .blx-root .blx-modenote{font-size:12.5px; color:var(--blx-sub); flex:1 1 100%}

  /* tiles */
  .blx-root .blx-tiles{
    display:grid; grid-template-columns:repeat(auto-fit,minmax(140px,1fr));
    gap:9px; margin-top:12px;
  }
  .blx-root .blx-tile{
    background:var(--blx-bg); border:1px solid var(--blx-line);
    border-radius:10px; padding:13px 15px;
  }
  .blx-root .blx-tile .blx-v{
    display:block; font-family:var(--blx-mono); font-variant-numeric:tabular-nums;
    font-size:22px; font-weight:600; letter-spacing:-.03em; margin-top:5px; color:var(--blx-ink);
  }
  .blx-root .blx-tile .blx-v small{font-size:12px; color:var(--blx-sub); font-weight:400}

  /* charts */
  .blx-root .blx-charts{
    display:grid; grid-template-columns:repeat(auto-fit,minmax(292px,1fr));
    gap:14px; margin-top:14px;
  }
  .blx-root .blx-card{
    background:var(--blx-bg); border:1px solid var(--blx-line);
    border-radius:12px; padding:18px 20px;
    display:flex; flex-direction:column;
  }
  /* the day chart grows to fill, so both cards end up the same height */
  .blx-root .blx-card .blx-cols{flex:1 1 auto; min-height:132px}
  /* Donut above, legend full-width below: at one article column the legend
     cannot sit beside the donut without wrapping its own labels. */
  .blx-root .blx-donutwrap{display:flex; flex-direction:column; align-items:center; gap:14px}
  .blx-root .blx-donutwrap svg{flex:0 0 auto; width:160px; height:160px}
  .blx-root .blx-legend{
    width:100%; display:flex; flex-direction:column; gap:7px;
    margin:0; padding:0; list-style:none;
  }
  .blx-root .blx-legend li::marker{content:none}
  .blx-root .blx-legend li{display:flex; align-items:center; gap:8px; font-size:12.5px; margin:0}
  .blx-root .blx-legend .blx-sw{width:10px; height:10px; border-radius:3px; flex:0 0 auto}
  .blx-root .blx-legend .blx-nm{flex:1; color:var(--blx-mut)}
  .blx-root .blx-legend .blx-pc{
    font-family:var(--blx-mono); font-variant-numeric:tabular-nums;
    color:var(--blx-ink); font-size:12px;
  }
  .blx-root .blx-arc{cursor:pointer; transition:opacity .12s}
  .blx-root .blx-arc:hover{opacity:.7}
  .blx-root .blx-arc.blx-dim{opacity:.2}

  .blx-root .blx-cols{display:flex; align-items:flex-end; gap:4px; height:132px}
  .blx-root .blx-col{
    flex:1; display:flex; flex-direction:column; justify-content:flex-end; gap:2px;
    height:100%; cursor:pointer;
  }
  .blx-root .blx-col .blx-seg{border-radius:2px}
  .blx-root .blx-col:hover .blx-seg{filter:brightness(1.15)}
  .blx-root .blx-colx{display:flex; gap:4px; margin-top:7px}
  .blx-root .blx-colx span{
    flex:1; text-align:center; font-family:var(--blx-mono);
    font-size:10px; color:var(--blx-sub);
  }

  /* filters */
  .blx-root .blx-filters{
    margin-top:20px; padding:12px 0 10px;
    border-top:1px solid var(--blx-line); border-bottom:1px solid var(--blx-line);
  }
  .blx-root .blx-frow{display:flex; flex-wrap:wrap; align-items:center; gap:6px; margin-bottom:8px}
  .blx-root .blx-frow > .blx-lbl{flex:0 0 60px}
  .blx-root .blx-btn{
    font-family:var(--blx-sans); font-size:12px; font-weight:550; cursor:pointer;
    border:1px solid var(--blx-line); background:var(--blx-bg); color:var(--blx-mut);
    border-radius:999px; padding:4px 11px; line-height:1.45; white-space:nowrap;
    display:inline-flex; align-items:center; gap:5px;
    transition:background .12s, color .12s, border-color .12s;
  }
  .blx-root .blx-btn:hover{background:var(--blx-bg2); color:var(--blx-ink)}
  .blx-root .blx-btn .blx-dot{width:8px; height:8px; border-radius:2px; flex:0 0 auto}
  .blx-root .blx-btn[aria-pressed="true"]{
    background:var(--blx-ink); color:var(--blx-bg); border-color:var(--blx-ink);
  }
  .blx-root .blx-btn[aria-pressed="true"] .blx-dot{box-shadow:0 0 0 1.5px var(--blx-bg)}
  .blx-root .blx-reset{border-style:dashed}
  .blx-root .blx-summary{
    display:flex; flex-wrap:wrap; align-items:baseline; gap:7px 14px;
    margin-top:9px; font-size:12.5px; color:var(--blx-mut);
  }
  .blx-root .blx-summary b{
    font-family:var(--blx-mono); font-variant-numeric:tabular-nums;
    font-size:18px; color:var(--blx-ink); font-weight:650; letter-spacing:-.02em;
  }

  /* ledger */
  .blx-root .blx-grp{margin-top:20px}
  .blx-root .blx-dayhd{
    display:flex; flex-wrap:wrap; align-items:baseline; gap:6px 10px;
    padding-bottom:6px; border-bottom:2px solid var(--blx-line2);
  }
  .blx-root .blx-dayhd .blx-d{font-size:15px; font-weight:700; color:var(--blx-ink)}
  .blx-root .blx-dayhd .blx-dt{font-size:12px; color:var(--blx-sub)}
  .blx-root .blx-dayhd .blx-base{
    font-size:10px; font-weight:700; letter-spacing:.08em;
    text-transform:uppercase; color:var(--blx-accent);
  }
  .blx-root .blx-dayhd .blx-dtot{
    margin-left:auto; font-family:var(--blx-mono); font-variant-numeric:tabular-nums;
    font-size:13px; color:var(--blx-ink);
  }
  .blx-root .blx-rows{list-style:none; margin:0; padding:0}
  .blx-root .blx-rows li{
    display:grid; grid-template-columns:26px 1fr auto; align-items:baseline;
    gap:3px 10px; padding:8px 2px; margin:0; border-bottom:1px solid var(--blx-line);
  }
  .blx-root .blx-rows li:last-child{border-bottom:0}
  .blx-root .blx-rows li::marker{content:none}
  .blx-root .blx-ic{font-size:15px; text-align:center; line-height:1.3}
  .blx-root .blx-desc{min-width:0}
  .blx-root .blx-t{display:block; color:var(--blx-ink)}
  .blx-root .blx-meta{
    display:flex; flex-wrap:wrap; gap:4px 8px; align-items:center;
    margin-top:2px; font-size:11px; color:var(--blx-sub);
  }
  .blx-root .blx-tag{display:inline-flex; align-items:center; gap:4px; white-space:nowrap}
  .blx-root .blx-tag .blx-dot{width:7px; height:7px; border-radius:2px}
  .blx-root .blx-shared{
    border:1px solid var(--blx-line); border-radius:999px; padding:0 6px;
  }
  .blx-root .blx-amts{text-align:right; white-space:nowrap}
  .blx-root .blx-my{
    display:block; font-family:var(--blx-mono); font-variant-numeric:tabular-nums; font-size:13px;
  }
  .blx-root .blx-id{
    display:block; font-family:var(--blx-mono); font-variant-numeric:tabular-nums;
    font-size:11px; color:var(--blx-sub); margin-top:1px;
  }
  .blx-root .blx-empty{padding:32px 0; text-align:center; color:var(--blx-sub); font-size:13px}

  /* table */
  .blx-root .blx-scroll{
    overflow-x:auto; margin-top:12px; border:1px solid var(--blx-line);
    border-radius:10px; background:var(--blx-bg);
  }
  .blx-root .blx-table{border-collapse:collapse; width:100%; min-width:420px; font-size:13px; margin:0}
  .blx-root .blx-table th,
  .blx-root .blx-table td{padding:9px 14px; text-align:left; border-bottom:1px solid var(--blx-line)}
  .blx-root .blx-table thead th{
    font-size:10px; font-weight:700; letter-spacing:.08em; text-transform:uppercase;
    color:var(--blx-sub); background:var(--blx-bg2); white-space:nowrap;
  }
  .blx-root .blx-table .blx-r{
    text-align:right; font-family:var(--blx-mono);
    font-variant-numeric:tabular-nums; white-space:nowrap;
  }
  .blx-root .blx-table thead .blx-r{font-family:var(--blx-sans)}
  .blx-root .blx-table tbody tr:last-child td{border-bottom:0}
  .blx-root .blx-table tfoot td{
    border-top:2px solid var(--blx-line2); border-bottom:0;
    font-weight:650; background:var(--blx-bg2);
  }
  .blx-root .blx-table small{display:block; font-size:11px; color:var(--blx-sub); margin-top:1px}

  @media (max-width:640px){
    .blx-root .blx-frow > .blx-lbl{flex-basis:100%; margin-bottom:1px}
    .blx-root .blx-rows li{grid-template-columns:24px 1fr}
    .blx-root .blx-amts{grid-column:2; text-align:left; margin-top:3px}
    .blx-root .blx-my,.blx-root .blx-id{display:inline; margin-right:8px}
  }
  @media (prefers-reduced-motion:reduce){.blx-root *{transition:none !important}}
</style>

