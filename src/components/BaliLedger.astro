        if(v<=0) return;
        const seg=document.createElement("div"); seg.className="blx-seg";
        seg.style.height=`${(v/max)*100}%`; seg.style.background=`var(${CATS[c].v})`;
        col.appendChild(seg);
      });
      col.onclick=()=>{ const b=[...root.querySelectorAll("#blxFDay .blx-btn")][DAYS.indexOf(d)]; if(b) b.click(); };
      wrap.appendChild(col);
      const s=document.createElement("span"); s.textContent=d; xs.appendChild(s);
    });
  }

  function list(rows){
    const box=$("blxList"); box.innerHTML="";
    if(!rows.length){
      box.innerHTML='<p class="blx-empty">Nothing matches those filters. Try clearing one.</p>';
      return;
    }
    DAYS.forEach(d=>{
      const dr=rows.filter(x=>x.d===d); if(!dr.length) return;
      const meta=dr[0];
      const grp=document.createElement("div"); grp.className="blx-grp";
      const hd=document.createElement("div"); hd.className="blx-dayhd";
      hd.innerHTML=`<span class="blx-d">Day ${d}</span><span class="blx-dt">${meta.date}</span>`
        +`<span class="blx-base">${meta.base}</span>`
        +`<span class="blx-dtot">${myr(dr.reduce((s,x)=>s+val(x),0))}</span>`;
      grp.appendChild(hd);
      const ul=document.createElement("ul"); ul.className="blx-rows";
      dr.slice().sort((a,b)=>val(b)-val(a)).forEach(x=>{
        const li=document.createElement("li");
        const shared = x.u && mode==="duo"
          ? `<span class="blx-tag blx-shared" title="One bill, split two ways">split</span>` : "";
        li.innerHTML=`<span class="blx-ic">${x.e}</span>`
          +`<span class="blx-desc"><span class="blx-t">${x.t}</span><span class="blx-meta">`
          +  `<span class="blx-tag"><span class="blx-dot" style="background:var(${CATS[x.c].v})"></span>${CATS[x.c].n}</span>`
          +  `<span class="blx-tag">📍 ${x.p}</span>${shared}`
          +`</span></span>`
          +`<span class="blx-amts"><span class="blx-my">${myr(val(x))}</span>`
          +  `<span class="blx-id"${x.a?' title="Billed in ringgit — rupiah figure converted"':''}>${x.a?"≈ ":""}${idr(rp(x))}</span></span>`;
        ul.appendChild(li);
      });
      grp.appendChild(ul); box.appendChild(grp);
    });
  }

  function stays(){
    const tb=$("blxStays"); tb.innerHTML="";
    let tot=0;
    STAYS.forEach(s=>{
      const cost = mode==="solo" ? (s.unit ? s.myr : s.myr/2) : s.myr/2;
      tot += cost;
      const desc = mode==="solo" ? s.solo : s.duo;
      const tr=document.createElement("tr");
      tr.innerHTML=`<td>${s.icon} ${s.name}<small>${desc}</small></td>`
        +`<td>${s.nights}</td>`
        +`<td class="blx-r">${myr(cost/s.nights)}</td>`
        +`<td class="blx-r">${myr(cost)}</td>`;
      tb.appendChild(tr);
    });
    $("blxStayTot").textContent=myr(tot);
    $("blxStayAvg").textContent=myr(tot/11);
    $("blxStayNote").textContent = mode==="solo"
      ? "Private rooms are costed at the full room rate here, and dorm beds at one bed — what one person actually pays."
      : "Private rooms are split two ways; dorm beds are already per bed.";
  }

  function render(){
    const rows=DATA.filter(hit);
    const m=rows.reduce((s,x)=>s+val(x),0), i=rows.reduce((s,x)=>s+rp(x),0);
    const g=GRAND();
    $("blxTotal").textContent=myr(g);
    $("blxPerDay").textContent=myr(g/12);
    $("blxIdr").innerHTML=`Rp ${(DATA.reduce((s,x)=>s+rp(x),0)/1e6).toLocaleString("de-DE",{minimumFractionDigits:2,maximumFractionDigits:2})}<small> jt</small>`;
    $("blxModeNote").textContent = mode==="solo"
      ? "One person, paying for their own room and their own share of everything else."
      : "Two people sharing a room and splitting the rides — this is the cost each.";
    $("blxSumMyr").textContent=myr(m);
    $("blxSumIdr").textContent=idr(i);
    $("blxSumCnt").textContent=`${rows.length} of ${DATA.length} expenses`;
    $("blxSumShare").textContent=(sel.c.size||sel.d.size)?`${(m/g*100).toFixed(1)}% of the trip`:"everything";
    donut(rows); cols(rows); list(rows); stays();
  }
  render();
})();
</script>
