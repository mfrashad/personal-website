---
// Dev-only review tool. Turn it on, click any paragraph (or select text and
// press C) to leave a note. Notes are saved to .dev-comments.json at the repo
// root so Claude can read them directly off disk.
// Rendered only when import.meta.env.DEV is true — see [slug].astro.
---

<div class="rv-root" id="rvRoot" data-active="false">
  <button type="button" class="rv-fab" id="rvFab" title="Toggle review mode (press R)">
    <span class="rv-fab-icon">💬</span>
    <span class="rv-fab-label">Review</span>
    <span class="rv-badge" id="rvBadge" hidden>0</span>
  </button>

  <aside class="rv-panel" id="rvPanel" hidden>
    <header class="rv-phead">
      <strong>Review notes</strong>
      <div class="rv-pacts">
        <button type="button" class="rv-mini" id="rvCopy" title="Copy all as markdown">Copy</button>
        <button type="button" class="rv-mini rv-danger" id="rvClear" title="Delete all notes on this page">Clear</button>
        <button type="button" class="rv-mini" id="rvClose">✕</button>
      </div>
    </header>
    <p class="rv-hintline" id="rvHint">Click any paragraph, heading or list item to comment on it. Or select text and press <kbd>C</kbd>.</p>
    <ul class="rv-list" id="rvList"></ul>
    <footer class="rv-pfoot">Saved to <code>.dev-comments.json</code></footer>
  </aside>

  <div class="rv-selbtn" id="rvSelBtn" hidden>💬 Comment on selection</div>

  <div class="rv-modal" id="rvModal" hidden>
    <div class="rv-box">
      <div class="rv-ctx" id="rvCtx"></div>
      <textarea class="rv-ta" id="rvTa" rows="4" placeholder="What's wrong with it?"></textarea>
      <div class="rv-acts">
        <span class="rv-tip"><kbd>⌘</kbd>+<kbd>Enter</kbd> to save</span>
        <button type="button" class="rv-mini" id="rvCancel">Cancel</button>
        <button type="button" class="rv-mini rv-primary" id="rvSave">Save note</button>
      </div>
    </div>
  </div>
</div>

<style is:global>
  .rv-root { --rv-acc:#D95F4E; --rv-ink:#111; --rv-bg:#fff; --rv-line:rgba(0,0,0,.14);
    font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }

  /* Class rules below set display:flex, which outranks the UA [hidden] rule.
     Without this, hiding these elements silently does nothing. */
  .rv-root [hidden], .rv-root[hidden] { display: none !important; }

  .rv-fab {
    position:fixed; right:18px; bottom:18px; z-index:9998;
    display:flex; align-items:center; gap:.4rem; cursor:pointer;
    font:inherit; font-size:.82rem; font-weight:700; color:var(--rv-ink);
    background:var(--rv-bg); border:1px solid var(--rv-line); border-radius:999px;
    padding:.5rem .9rem; box-shadow:0 6px 20px rgba(0,0,0,.16);
  }
  .rv-root[data-active="true"] .rv-fab { background:var(--rv-acc); color:#fff; border-color:var(--rv-acc); }
  .rv-badge { background:var(--rv-acc); color:#fff; border-radius:999px; font-size:.7rem; padding:.05rem .4rem; }
  .rv-root[data-active="true"] .rv-badge { background:#fff; color:var(--rv-acc); }

  .rv-panel {
    position:fixed; right:18px; bottom:70px; z-index:9998; width:min(380px, calc(100vw - 36px));
    max-height:62vh; display:flex; flex-direction:column;
    background:var(--rv-bg); color:var(--rv-ink); border:1px solid var(--rv-line);
    border-radius:12px; box-shadow:0 12px 40px rgba(0,0,0,.2); overflow:hidden;
  }
  .rv-phead { display:flex; align-items:center; justify-content:space-between; gap:.5rem;
    padding:.6rem .7rem; border-bottom:1px solid var(--rv-line); font-size:.85rem; }
  .rv-pacts { display:flex; gap:.3rem; }
  .rv-mini { font:inherit; font-size:.72rem; font-weight:600; cursor:pointer; color:var(--rv-ink);
    background:#f1f5f9; border:1px solid var(--rv-line); border-radius:7px; padding:.25rem .5rem; }
  .rv-mini.rv-primary { background:var(--rv-acc); color:#fff; border-color:var(--rv-acc); }
  .rv-mini.rv-danger { color:#b3392a; }
  .rv-hintline { font-size:.72rem; color:#555; margin:0; padding:.5rem .7rem; background:#fafafa; line-height:1.45; }
  .rv-hintline kbd { background:#fff; border:1px solid var(--rv-line); border-radius:4px; padding:0 .25rem; font-size:.68rem; }
  .rv-list { list-style:none; margin:0; padding:.4rem; overflow-y:auto; display:flex; flex-direction:column; gap:.4rem; }
  .rv-item { border:1px solid var(--rv-line); border-radius:9px; padding:.5rem .6rem; font-size:.78rem; background:#fff; }
  .rv-item .rv-where { font-size:.66rem; text-transform:uppercase; letter-spacing:.05em; color:#888; }
  .rv-item .rv-quote { color:#555; font-style:italic; margin:.2rem 0; line-height:1.4;
    display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
  .rv-item .rv-note { line-height:1.45; }
  .rv-item .rv-del { float:right; cursor:pointer; color:#b3392a; font-size:.7rem; border:0; background:none; }
  .rv-pfoot { font-size:.66rem; color:#888; padding:.4rem .7rem; border-top:1px solid var(--rv-line); }
  .rv-pfoot code { font-size:.66rem; }

  .rv-selbtn {
    position:absolute; z-index:9999; cursor:pointer; font-size:.74rem; font-weight:700;
    background:var(--rv-acc); color:#fff; border-radius:999px; padding:.3rem .7rem;
    box-shadow:0 4px 14px rgba(0,0,0,.25);
  }

  .rv-modal { position:fixed; inset:0; z-index:9999; background:rgba(0,0,0,.45);
    display:flex; align-items:center; justify-content:center; padding:1rem; }
  .rv-box { background:var(--rv-bg); color:var(--rv-ink); border-radius:12px; padding:.9rem;
    width:min(520px,100%); box-shadow:0 20px 60px rgba(0,0,0,.35); }
  .rv-ctx { font-size:.75rem; color:#555; background:#f1f5f9; border-radius:8px; padding:.5rem .6rem;
    margin-bottom:.5rem; line-height:1.45; max-height:120px; overflow:auto; }
  .rv-ctx b { color:var(--rv-ink); }
  .rv-ta { width:100%; font:inherit; font-size:.85rem; padding:.5rem .6rem; border-radius:8px;
    border:1px solid var(--rv-line); resize:vertical; box-sizing:border-box; }
  .rv-acts { display:flex; gap:.4rem; justify-content:flex-end; align-items:center; margin-top:.55rem; }
  .rv-tip { font-size:.68rem; color:#888; margin-right:auto; }
  .rv-tip kbd { background:#f1f5f9; border:1px solid var(--rv-line); border-radius:4px; padding:0 .25rem; }

  /* target highlighting, only while review mode is on */
  body.rv-on .rv-target { outline:2px dashed rgba(217,95,78,.55); outline-offset:3px; cursor:pointer; }
  body.rv-on .rv-target:hover { outline-style:solid; background:rgba(217,95,78,.07); }
  body.rv-on .rv-has-note { outline:2px solid rgba(217,95,78,.85); outline-offset:3px; }
  .rv-flag { display:inline-block; margin-left:.35rem; font-size:.7rem; vertical-align:super; }
</style>

<script>
  (() => {
    const root  = document.getElementById('rvRoot');
    if (!root) return;
    const fab   = document.getElementById('rvFab');
    const panel = document.getElementById('rvPanel');
    const list  = document.getElementById('rvList');
    const badge = document.getElementById('rvBadge');
    const modal = document.getElementById('rvModal');
    const ta    = document.getElementById('rvTa');
    const ctx   = document.getElementById('rvCtx');
    const selBtn= document.getElementById('rvSelBtn');

    const PATH = location.pathname;
    const API  = '/api/dev-comments';
    const SEL  = 'p, h2, h3, h4, li, blockquote, td, figcaption';

    let comments = [];
    let pending = null;   // {heading, tag, nth, snippet, selection, el}
    let active = false;

    const article = document.querySelector('article') || document.body;

    function targets() {
      return Array.from(article.querySelectorAll(SEL))
        .filter(el => !el.closest('.rv-root') && (el.textContent || '').trim().length > 0);
    }

    function nearestHeading(el) {
      let n = el;
      while (n && n !== article) {
        let p = n.previousElementSibling;
        while (p) {
          if (/^H[1-4]$/.test(p.tagName)) return p.textContent.trim();
          const inner = p.querySelector && p.querySelector('h2, h3, h4');
          if (inner) return inner.textContent.trim();
          p = p.previousElementSibling;
        }
        n = n.parentElement;
      }
      return '(top of page)';
    }

    async function load() {
      try {
        const r = await fetch(API + '?path=' + encodeURIComponent(PATH));
        comments = r.ok ? await r.json() : [];
      } catch { comments = []; }
      render();
    }

    function render() {
      badge.textContent = String(comments.length);
      badge.hidden = comments.length === 0;
      list.innerHTML = '';
      comments.forEach((c) => {
        const li = document.createElement('li');
        li.className = 'rv-item';
        li.innerHTML =
          '<button class="rv-del" data-id="' + c.id + '">delete</button>' +
          '<div class="rv-where">' + (c.heading || '(top)') + ' · ' + c.tag + '#' + c.nth + '</div>' +
          '<div class="rv-quote">“' + (c.selection || c.snippet) + '”</div>' +
          '<div class="rv-note">' + c.note + '</div>';
        list.appendChild(li);
      });
      list.querySelectorAll('.rv-del').forEach(b => {
        b.addEventListener('click', async () => {
          await fetch(API + '?id=' + b.dataset.id, { method: 'DELETE' });
          load();
        });
      });
      markNoted();
    }

    function markNoted() {
      targets().forEach((el, i) => {
        const hit = comments.some(c => c.tag === el.tagName.toLowerCase() && c.nth === i);
        el.classList.toggle('rv-has-note', hit && active);
      });
    }

    function paint() {
      const t = targets();
      t.forEach(el => el.classList.toggle('rv-target', active));
      markNoted();
    }

    function openModal(info) {
      pending = info;
      ctx.innerHTML =
        '<b>' + info.heading + '</b><br>' +
        '<span>“' + (info.selection || info.snippet) + '”</span>';
      ta.value = '';
      modal.hidden = false;
      ta.focus();
    }

    async function save() {
      const note = ta.value.trim();
      if (!note || !pending) return;
      await fetch(API, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          path: PATH, heading: pending.heading, tag: pending.tag,
          nth: pending.nth, snippet: pending.snippet,
          selection: pending.selection, note
        })
      });
      modal.hidden = true; pending = null;
      load();
    }

    function infoFromEl(el, selectionText) {
      const t = targets();
      const nth = t.indexOf(el);
      const text = (el.textContent || '').trim();
      return {
        heading: nearestHeading(el),
        tag: el.tagName.toLowerCase(),
        nth,
        snippet: text.slice(0, 160),
        selection: selectionText || ''
      };
    }

    // --- interactions ---
    article.addEventListener('click', (e) => {
      if (!active) return;
      const el = e.target.closest(SEL);
      if (!el || el.closest('.rv-root')) return;
      e.preventDefault(); e.stopPropagation();
      openModal(infoFromEl(el));
    }, true);

    document.addEventListener('selectionchange', () => {
      if (!active) { selBtn.hidden = true; return; }
      const s = window.getSelection();
      if (!s || s.isCollapsed || !s.toString().trim()) { selBtn.hidden = true; return; }
      const r = s.getRangeAt(0).getBoundingClientRect();
      selBtn.style.top  = (window.scrollY + r.top - 34) + 'px';
      selBtn.style.left = (window.scrollX + r.left) + 'px';
      selBtn.hidden = false;
    });

    function commentOnSelection() {
      const s = window.getSelection();
      if (!s || s.isCollapsed) return;
      const text = s.toString().trim();
      let node = s.anchorNode;
      if (node && node.nodeType === 3) node = node.parentElement;
      const el = node && node.closest ? node.closest(SEL) : null;
      selBtn.hidden = true;
      openModal(el ? infoFromEl(el, text)
                   : { heading: '(unknown)', tag: '?', nth: -1, snippet: text, selection: text });
    }
    selBtn.addEventListener('mousedown', (e) => { e.preventDefault(); commentOnSelection(); });

    function setActive(v) {
      active = v;
      root.dataset.active = String(v);
      document.body.classList.toggle('rv-on', v);
      panel.hidden = !v;
      if (!v) selBtn.hidden = true;
      paint();
    }

    fab.addEventListener('click', () => setActive(!active));
    document.getElementById('rvClose').addEventListener('click', () => setActive(false));
    document.getElementById('rvCancel').addEventListener('click', () => { modal.hidden = true; pending = null; });
    document.getElementById('rvSave').addEventListener('click', save);

    document.getElementById('rvClear').addEventListener('click', async () => {
      if (!confirm('Delete all notes on this page?')) return;
      await fetch(API + '?id=all&path=' + encodeURIComponent(PATH), { method: 'DELETE' });
      load();
    });

    document.getElementById('rvCopy').addEventListener('click', () => {
      const md = comments.map((c, i) =>
        (i + 1) + '. **' + (c.heading || 'top') + '** (' + c.tag + '#' + c.nth + ')\n' +
        '   > ' + (c.selection || c.snippet) + '\n' +
        '   — ' + c.note
      ).join('\n\n');
      navigator.clipboard.writeText('## Review: ' + PATH + '\n\n' + md);
      const b = document.getElementById('rvCopy');
      b.textContent = 'Copied'; setTimeout(() => (b.textContent = 'Copy'), 1200);
    });

    document.addEventListener('keydown', (e) => {
      const typing = /INPUT|TEXTAREA/.test(document.activeElement?.tagName || '');
      if (e.key === 'Escape') { modal.hidden = true; pending = null; selBtn.hidden = true; return; }
      if ((e.metaKey || e.ctrlKey) && e.key === 'Enter' && !modal.hidden) { save(); return; }
      if (typing) return;
      if (e.key === 'r' || e.key === 'R') setActive(!active);
      if ((e.key === 'c' || e.key === 'C') && active) commentOnSelection();
    });

    load();
  })();
</script>
