---
import Layout from '@layouts/Layout.astro';
import Grid from '@components/Grid.astro';
import GridBox from '@components/GridBox.astro';
import DetailGallery from '@components/speaking/DetailGallery';
import { hackathonEngagements } from '@data/hackathons';
import imageManifest from '@data/speaking-images.json';

export function getStaticPaths() {
    return hackathonEngagements.map((engagement) => ({
        params: { id: engagement.id },
    }));
}

const { id } = Astro.params;
const engagement = hackathonEngagements.find((e) => e.id === id)!;
const images = (imageManifest as Record<string, string[]>)[id] || [];

const formattedDate = engagement.date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
});

const description = engagement.description
    || `${engagement.title} - ${engagement.role} at ${engagement.event} by ${engagement.organizer}`;

const roleBadgeColors: Record<string, string> = {
    judge: 'bg-amber-100 text-amber-700',
    mentor: 'bg-blue-100 text-blue-700',
    participant: 'bg-green-100 text-green-700',
    sponsor: 'bg-purple-100 text-purple-700',
};
---

<Layout
    title={`${engagement.title} - ${engagement.event} | Hackathons | Rashad`}
    description={description}
>
    <Grid>
        <GridBox desktopFull classes="pt-40 lg:pt-28 pb-32">
            <div class="mx-auto w-full max-w-[960px]">
                <a
                    href="/hackathons"
                    class="text-sm text-neutral-500 hover:text-neutral-800 mb-6 inline-flex items-center gap-1"
                >
                    &larr; Back to Hackathons
                </a>

                <div class="mb-8">
                    <div class="flex items-center gap-3 mb-2">
                        <h1 class="text-2xl font-bold md:text-3xl">{engagement.title}</h1>
                        <span class={`text-xs px-2 py-1 rounded-full capitalize shrink-0 ${roleBadgeColors[engagement.role] || 'bg-neutral-100 text-neutral-600'}`}>
                            {engagement.role}
                        </span>
                    </div>

                    <div class="space-y-1 text-neutral-600">
                        <p class="text-lg">{engagement.event}</p>
                        <p class="text-sm">
                            Organized by <span class="font-medium">{engagement.organizer}</span>
                        </p>
                        <p class="text-sm">{formattedDate}</p>
                        {engagement.location && (
                            <p class="text-sm">{engagement.location}</p>
                        )}
                    </div>

                    {engagement.topics && engagement.topics.length > 0 && (
                        <div class="flex flex-wrap gap-2 mt-4">
                            {engagement.topics.map((topic) => (
                                <span class="text-xs px-3 py-1 bg-amber-50 text-amber-700 rounded-full">
                                    {topic}
                                </span>
                            ))}
                        </div>
                    )}

                    {engagement.description && (
                        <p class="mt-4 text-neutral-700">{engagement.description}</p>
                    )}

                    {engagement.result && (
                        <p class="mt-2 text-neutral-700 font-medium">{engagement.result}</p>
                    )}
                </div>

                {images.length > 0 && (
                    <section>
                        <h2 class="text-lg font-bold mb-4 text-neutral-800">
                            Photos ({images.length})
                        </h2>
                        <DetailGallery
                            client:load
                            images={images}
                            title={engagement.title}
                        />
                    </section>
                )}
            </div>
        </GridBox>
    </Grid>
</Layout>
