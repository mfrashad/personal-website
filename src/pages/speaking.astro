---
import Layout from '@layouts/Layout.astro';
import Grid from '@components/Grid.astro';
import GridBox from '@components/GridBox.astro';
import SpeakingGalleryList from '@components/speaking/SpeakingGalleryList';
import { speakingEngagements, getSpeakingByYear } from '@data/speaking';
import imageManifest from '@data/speaking-images.json';

// Get engagements organized by year
const engagementsByYear = getSpeakingByYear();
const years = Object.keys(engagementsByYear)
    .map(Number)
    .sort((a, b) => b - a); // Newest first

// Separate into upcoming and past
const now = new Date();
const upcomingEngagements = speakingEngagements.filter((eng) => eng.date > now);

// Pre-process past engagements by year, serialized for React
const pastYearGroups = years
    .map(year => ({
        year,
        engagements: engagementsByYear[year]
            .filter(e => e.date <= now)
            .map(e => ({
                ...e,
                date: e.date.toISOString(),
            }))
    }))
    .filter(({ engagements }) => engagements.length > 0);

// Collect all speaking images for structured data
const allSpeakingImages = Object.entries(imageManifest as Record<string, string[]>).flatMap(
    ([eventSlug, images]) => {
        const event = speakingEngagements.find(e => e.id === eventSlug);
        return images.map((img: string) => ({
            "@type": "ImageObject",
            "url": `https://www.mfrashad.com${img}`,
            "name": `Fathy Rashad at ${event?.title || eventSlug}`,
            "description": `Fathy Rashad speaking at ${event?.title || eventSlug}`,
        }));
    }
);

const speakingSchema = {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "Fathy Rashad Speaking Engagements",
    "description": "Conference talks, panels, workshops, and interviews by Fathy Rashad on AI, entrepreneurship, and technology.",
    "url": "https://www.mfrashad.com/speaking",
    "image": allSpeakingImages.slice(0, 50),
    "author": {
        "@type": "Person",
        "name": "Fathy Rashad",
        "url": "https://www.mfrashad.com"
    }
};
---

<Layout
    title="Speaking | Fathy Rashad"
    description="Conference talks, presentations, and speaking engagements by Fathy Rashad (Rashadventure)"
>
    <script type="application/ld+json" set:html={JSON.stringify(speakingSchema)} />
    <Grid>
        <GridBox desktopFull classes="pt-40 lg:pt-28 pb-32">
            <div class="mx-auto w-full max-w-[960px]">
                <h1 class="mb-4 text-2xl font-bold md:text-3xl">Speaking</h1>
                <p class="mb-8 text-lg text-neutral-600">
                    Conference talks, panels, workshops, and interviews on AI, entrepreneurship, and technology.
                </p>

                <!-- Invite CTA -->
                <div class="mb-12 p-5 sm:p-6 bg-neutral-900 text-white rounded-xl">
                    <h2 class="text-base sm:text-lg font-bold mb-2">Invite me to speak at your event</h2>
                    <p class="text-sm text-neutral-300 mb-4 leading-relaxed">
                        I speak about AI, career development, entrepreneurship & startups, hackathons, and tech. Available for keynotes, panels, workshops, and fireside chats at conferences, universities, and corporate events.
                    </p>
                    <div class="flex flex-wrap items-center gap-2.5">
                        <a
                            href="mailto:m.fathyrashad@gmail.com"
                            class="inline-flex items-center gap-1.5 px-4 py-2 bg-white text-neutral-900 text-xs sm:text-sm font-medium rounded-lg hover:bg-neutral-200 transition-colors"
                        >
                            Get in touch
                        </a>
                        <a
                            href="/media"
                            class="inline-flex items-center gap-1.5 px-4 py-2 border border-neutral-600 text-neutral-300 text-xs sm:text-sm font-medium rounded-lg hover:bg-neutral-800 transition-colors"
                        >
                            Speaker kit &amp; media assets →
                        </a>
                    </div>
                </div>

                {
                    speakingEngagements.length === 0 ? (
                        <div class="text-center py-16">
                            <p class="text-neutral-500 text-lg">
                                No speaking engagements yet. Check back soon!
                            </p>
                        </div>
                    ) : (
                        <>
                            {/* Upcoming Engagements */}
                            {upcomingEngagements.length > 0 && (
                                <section class="mb-16">
                                    <h2 class="text-xl font-bold mb-6 text-neutral-800">Upcoming</h2>
                                    <div class="space-y-3">
                                        {upcomingEngagements
                                            .sort((a, b) => a.date.getTime() - b.date.getTime())
                                            .map((engagement) => (
                                                <article class="p-5 bg-blue-50 border-l-4 border-blue-600 rounded-lg hover:bg-blue-100 transition-colors">
                                                    <div class="flex items-start justify-between gap-4">
                                                        <div class="flex-1">
                                                            <div class="flex items-center gap-2 mb-2">
                                                                <h3 class="text-lg font-bold">
                                                                    {engagement.title}
                                                                </h3>
                                                                <span class="text-xs px-2 py-1 bg-blue-600 text-white rounded-full capitalize">
                                                                    {engagement.type}
                                                                </span>
                                                            </div>
                                                            <p class="text-neutral-700 text-sm mb-1">
                                                                {engagement.event} • <span class="text-neutral-600">{engagement.organizer}</span>
                                                                {engagement.location && <> • 📍 {engagement.location}</>}
                                                            </p>
                                                            <p class="text-neutral-500 text-xs mb-2">
                                                                📅{' '}
                                                                {engagement.date.toLocaleDateString('en-US', {
                                                                    year: 'numeric',
                                                                    month: 'long',
                                                                    day: 'numeric',
                                                                })}
                                                            </p>
                                                            {engagement.audience && (
                                                                <p class="text-neutral-600 text-xs">
                                                                    👥 {engagement.audience}
                                                                </p>
                                                            )}
                                                        </div>
                                                    </div>
                                                </article>
                                            ))}
                                    </div>
                                </section>
                            )}

                            {/* Past Engagements by Year */}
                            {pastYearGroups.length > 0 && (
                                <section>
                                    <h2 class="text-xl font-bold mb-6 text-neutral-800">Past Talks</h2>
                                    <SpeakingGalleryList
                                        client:visible
                                        yearGroups={pastYearGroups}
                                        imageManifest={imageManifest}
                                    />
                                </section>
                            )}
                        </>
                    )
                }
            </div>
        </GridBox>
    </Grid>
</Layout>
