---
import Layout from '@layouts/Layout.astro';
import Grid from '@components/Grid.astro';
import GridBox from '@components/GridBox.astro';
import HackathonGalleryList from '@components/hackathons/HackathonGalleryList';
import { hackathonEngagements, getHackathonsByYear } from '@data/hackathons';
import imageManifest from '@data/speaking-images.json';

const engagementsByYear = getHackathonsByYear();
const years = Object.keys(engagementsByYear)
    .map(Number)
    .sort((a, b) => b - a);

const now = new Date();
const upcomingEngagements = hackathonEngagements.filter((eng) => eng.date > now);

const pastYearGroups = years
    .map(year => ({
        year,
        engagements: engagementsByYear[year]
            .filter(e => e.date <= now)
            .map(e => ({
                ...e,
                date: e.date.toISOString(),
            }))
    }))
    .filter(({ engagements }) => engagements.length > 0);
---

<Layout
    title="Hackathons | Fathy Rashad"
    description="Hackathon judging, mentoring, and participation by Muhammad Fathy Rashad"
>
    <Grid>
        <GridBox desktopFull classes="pt-40 lg:pt-28 pb-32">
            <div class="mx-auto w-full max-w-[960px]">
                <h1 class="mb-4 text-2xl font-bold md:text-3xl">Hackathons</h1>
                <p class="mb-8 text-lg text-neutral-600">
                    Judging, mentoring, and participating in hackathons across Malaysia. 10+ events and counting.
                </p>

                {hackathonEngagements.length === 0 ? (
                    <div class="text-center py-16">
                        <p class="text-neutral-500 text-lg">
                            No hackathon engagements yet. Check back soon!
                        </p>
                    </div>
                ) : (
                    <>
                        {/* Upcoming */}
                        {upcomingEngagements.length > 0 && (
                            <section class="mb-16">
                                <h2 class="text-xl font-bold mb-6 text-neutral-800">Upcoming</h2>
                                <div class="space-y-3">
                                    {upcomingEngagements
                                        .sort((a, b) => a.date.getTime() - b.date.getTime())
                                        .map((engagement) => (
                                            <article class="p-5 bg-amber-50 border-l-4 border-amber-600 rounded-lg hover:bg-amber-100 transition-colors">
                                                <div class="flex items-start justify-between gap-4">
                                                    <div class="flex-1">
                                                        <div class="flex items-center gap-2 mb-2">
                                                            <h3 class="text-lg font-bold">
                                                                {engagement.title}
                                                            </h3>
                                                            <span class="text-xs px-2 py-1 bg-amber-600 text-white rounded-full capitalize">
                                                                {engagement.role}
                                                            </span>
                                                        </div>
                                                        <p class="text-neutral-700 text-sm mb-1">
                                                            {engagement.event} &middot; <span class="text-neutral-600">{engagement.organizer}</span>
                                                            {engagement.location && <> &middot; {engagement.location}</>}
                                                        </p>
                                                        <p class="text-neutral-500 text-xs">
                                                            {engagement.date.toLocaleDateString('en-US', {
                                                                year: 'numeric',
                                                                month: 'long',
                                                                day: 'numeric',
                                                            })}
                                                        </p>
                                                    </div>
                                                </div>
                                            </article>
                                        ))}
                                </div>
                            </section>
                        )}

                        {/* Past */}
                        {pastYearGroups.length > 0 && (
                            <section>
                                <h2 class="text-xl font-bold mb-6 text-neutral-800">Past Events</h2>
                                <HackathonGalleryList
                                    client:visible
                                    yearGroups={pastYearGroups}
                                    imageManifest={imageManifest}
                                />
                            </section>
                        )}
                    </>
                )}
            </div>
        </GridBox>
    </Grid>
</Layout>
