---
import Layout from '@layouts/Layout.astro';
import Grid from '@components/Grid.astro';
import GridBox from '@components/GridBox.astro';
import ContentPage from '@components/content/ContentPage';
import { contentPieces, contentCategories, brandLogos, getContentByType, getTotalMetrics } from '@data/content-creation';
import imageManifest from '@data/content-images.json';

const contentByType = getContentByType();
const totalMetrics = getTotalMetrics();
const fmt = (n: number) =>
    n >= 1_000_000 ? (n / 1_000_000).toFixed(1) + 'M' : n >= 1_000 ? (n / 1_000).toFixed(n >= 10_000 ? 0 : 1) + 'K' : n.toLocaleString();
const stats = [
    { value: fmt(totalMetrics.views), label: 'Total views' },
    { value: fmt(totalMetrics.likes), label: 'Total likes' },
    { value: fmt(totalMetrics.followers), label: 'Followers' },
];

// Serialize for React. Pick fields explicitly rather than spreading: island props
// are embedded in the delivered HTML, so a spread publishes every field on
// ContentPiece — including any private ones (see contentPayments in @data/content-creation).
// "OATSIDE x Sony" → one badge per brand, with its logo when we have one.
const logoByName = new Map(brandLogos.map((l) => [l.name.toLowerCase(), l]));
const brandBadges = (brand?: string) =>
    brand
        ? brand.split(/\s+x\s+/i).map((name) => {
              const logo = logoByName.get(name.trim().toLowerCase());
              return { name, src: logo?.src, scale: logo?.scale };
          })
        : undefined;

const serializedByType: Record<string, any[]> = {};
for (const [type, pieces] of Object.entries(contentByType)) {
    serializedByType[type] = pieces.map(p => ({
        id: p.id,
        title: p.title,
        platform: p.platform,
        url: p.url,
        brand: p.brand,
        brands: brandBadges(p.brand),
        tags: p.tags,
        metrics: { views: p.metrics.views, likes: p.metrics.likes },
        crossPosts: (p.crossPosts ?? []).map(c => ({
            platform: c.platform,
            url: c.url,
            metrics: { views: c.metrics.views, likes: c.metrics.likes },
        })),
    }));
}
---

<Layout
    title="Content Creation | Fathy Rashad"
    description="Content creation portfolio - advocacy, educational content, brand collaborations, cafe hopping, and experience reviews"
>
    <Grid>
        <GridBox desktopFull classes="pt-20 sm:pt-40 lg:pt-28 pb-32">
            <div class="mx-auto w-full max-w-[960px]">
                <!-- Intro: mirrors the Instagram bio -->
                <h1 class="mb-6 text-center text-xs font-medium uppercase tracking-[0.3em] text-neutral-400 sm:mb-8">Content Creation</h1>
                <div class="mb-10 flex flex-col items-center gap-4 text-center sm:mb-14">
                    <a href="https://instagram.com/rashadventure" target="_blank" rel="noopener noreferrer" class="flex-shrink-0">
                        <img
                            src="/content-images/profile/rashadventure.jpg"
                            alt="Rashad (@rashadventure)"
                            width="112"
                            height="112"
                            class="h-24 w-24 rounded-full object-cover ring-2 ring-neutral-200 ring-offset-2 sm:h-28 sm:w-28"
                        />
                    </a>
                    <div class="min-w-0 text-sm leading-relaxed text-neutral-800 sm:text-base">
                        <div class="flex flex-wrap items-center justify-center gap-x-3 gap-y-1">
                            <a href="https://instagram.com/rashadventure" target="_blank" rel="noopener noreferrer" class="text-md font-bold text-neutral-900 hover:underline underline-offset-2 sm:text-lg">rashadventure</a>
                        </div>
                        <div class="my-3 flex items-center justify-center gap-6 sm:gap-10">
                            {stats.map((s) => (
                                <div>
                                    <div class="text-lg font-bold leading-none text-neutral-900 sm:text-2xl sm:leading-none">{s.value}</div>
                                    <div class="mt-1 text-[10px] uppercase leading-tight tracking-wide text-neutral-500 sm:text-xs sm:leading-tight">{s.label}</div>
                                </div>
                            ))}
                        </div>
                        <p>advocacy, sidequest, tech &amp; startup (18k on tiktok)</p>
                        <p>🌍 build tech for non-profits <a href="https://instagram.com/build4public" class="font-medium text-[#4a5df9] hover:underline underline-offset-2" target="_blank" rel="noopener noreferrer">@build4public</a></p>
                        <p>💻 co-founder/cto <a href="https://instagram.com/cleve.ai" class="font-medium text-[#4a5df9] hover:underline underline-offset-2" target="_blank" rel="noopener noreferrer">@cleve.ai</a></p>
                        <p>📩 <a href="mailto:rashadventure.work@gmail.com" class="hover:underline underline-offset-2">rashadventure.work@gmail.com</a></p>
                        <div class="mt-4 flex items-center justify-center gap-2">
                            <a href="https://instagram.com/rashadventure" target="_blank" rel="noopener noreferrer" aria-label="Instagram" title="Instagram" class="flex h-7 w-7 items-center justify-center rounded-full border border-neutral-200 text-neutral-500 transition-colors hover:border-neutral-900 hover:bg-neutral-900 hover:text-white">
                                <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="2.5" y="2.5" width="19" height="19" rx="5.5" /><circle cx="12" cy="12" r="4.5" /><circle cx="17.6" cy="6.4" r="1.3" fill="currentColor" stroke="none" /></svg>
                            </a>
                            <a href="https://tiktok.com/@rashadventure" target="_blank" rel="noopener noreferrer" aria-label="TikTok" title="TikTok" class="flex h-7 w-7 items-center justify-center rounded-full border border-neutral-200 text-neutral-500 transition-colors hover:border-neutral-900 hover:bg-neutral-900 hover:text-white">
                                <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1v-3.5a6.37 6.37 0 00-.79-.05A6.34 6.34 0 003.15 15.2a6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.34-6.34V8.73a8.19 8.19 0 004.76 1.52V6.8a4.84 4.84 0 01-1-.11z" /></svg>
                            </a>
                        </div>
                    </div>
                </div>

                <ContentPage
                    client:visible
                    brandLogos={brandLogos}
                    contentByType={serializedByType}
                    categories={contentCategories}
                    imageManifest={imageManifest}
                />

            </div>
        </GridBox>
    </Grid>
</Layout>
