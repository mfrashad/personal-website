---
export const prerender = false;

import Layout from '@layouts/Layout.astro';
import Grid from '@components/Grid.astro';
import GridBox from '@components/GridBox.astro';
import PostcardForm from '@components/postcards/PostcardForm';
import PostcardGallery from '@components/postcards/PostcardGallery';
import SpriteCharacter from '@components/animations/SpriteCharacter';
import { SPRITES } from '@data/sprites';

let postcards: any[] = [];
try {
    const { getPostcards, initDb } = await import('@lib/postcards-db');
    await initDb();
    postcards = await getPostcards(0, 100);
} catch (e) {
    console.error('Failed to load postcards from Turso:', e);
}
---

<Layout title="Postcards" description="A guestbook of drawings and messages from visitors">
    <Grid>
        <GridBox desktopFull classes="pt-40 lg:pt-28 pb-32">
            <div class="mx-auto w-full max-w-[960px]">
                <h1 class="text-2xl font-bold md:text-3xl mb-2">Postcards</h1>
                <p class="mb-10 text-neutral-600">
                    I love the idea of people stopping by and leaving a trace. Say hi, doodle a stamp, and leave a little piece of yourself here.
                </p>

                <!-- Inline postcard form -->
                <div class="mb-16">
                    <PostcardForm client:load />
                </div>

                <!-- Gallery -->
                <PostcardGallery initialPostcards={postcards} client:load />
            </div>
        </GridBox>
    </Grid>
</Layout>
