---
import Layout from '@layouts/Layout.astro';
import Grid from '@components/Grid.astro';
import GridBox from '@components/GridBox.astro';
import SpriteCharacter from '@components/animations/SpriteCharacter';
import { SPRITES } from '@data/sprites';
import MentionGalleryList from '@components/mentions/MentionGalleryList';
import { mediaMentions } from '@data/media-mentions';

// Sort mentions by date (newest first)
const sortedMentions = [...mediaMentions].sort((a, b) =>
    new Date(b.date).getTime() - new Date(a.date).getTime()
);

// Group by year
const mentionsByYear: Record<number, typeof sortedMentions> = {};
for (const mention of sortedMentions) {
    const year = new Date(mention.date).getFullYear();
    if (!mentionsByYear[year]) mentionsByYear[year] = [];
    mentionsByYear[year].push(mention);
}
const years = Object.keys(mentionsByYear).map(Number).sort((a, b) => b - a);

const yearGroups = years.map(year => ({
    year,
    mentions: mentionsByYear[year],
}));
---

<Layout title="Media Mentions | Fathy Rashad" description="Press coverage, interviews, and media appearances">
    <Grid>
        <GridBox desktopFull classes="pt-40 lg:pt-28 pb-32">
            <div class="mx-auto w-full max-w-[960px]">
                <div class="flex items-end gap-2 mb-4">
                    <h1 class="text-2xl font-bold md:text-3xl">Media Mentions</h1>
                    <div class="relative" style="top: -5px;">
                        <SpriteCharacter config={SPRITES.taking_photos} scale={0.35} client:visible />
                    </div>
                </div>
                <p class="mb-8 text-lg text-neutral-600">
                    Press coverage, interviews, and media appearances.
                </p>

                <!-- Feature CTA -->
                <div class="mb-12 p-5 sm:p-6 bg-neutral-900 text-white rounded-xl">
                    <h2 class="text-base sm:text-lg font-bold mb-2">Want to feature me?</h2>
                    <p class="text-sm text-neutral-300 mb-4 leading-relaxed">
                        I'm available for interviews, features, and commentary on AI, startups, tech careers, and content creation.
                    </p>
                    <div class="flex flex-wrap items-center gap-2.5">
                        <a
                            href="mailto:m.fathyrashad@gmail.com"
                            class="inline-flex items-center gap-1.5 px-4 py-2 bg-white text-neutral-900 text-xs sm:text-sm font-medium rounded-lg hover:bg-neutral-200 transition-colors"
                        >
                            Get in touch
                        </a>
                        <a
                            href="/media"
                            class="inline-flex items-center gap-1.5 px-4 py-2 border border-neutral-600 text-neutral-300 text-xs sm:text-sm font-medium rounded-lg hover:bg-neutral-800 transition-colors"
                        >
                            Press kit & media assets &rarr;
                        </a>
                    </div>
                </div>

                <MentionGalleryList yearGroups={yearGroups} client:visible />
            </div>
        </GridBox>
    </Grid>
</Layout>
