---
import Layout from '@layouts/Layout.astro';
import Grid from '@components/Grid.astro';
import GridBox from '@components/GridBox.astro';
import SectionContent from '@components/SectionContent.astro';
import AchievementGrid from '@components/home/AchievementGrid';
import { achievements, metrics } from '@data/achievements';
import { skills } from '@data/skills';

const skillImages: Record<string, string> = {};
for (const skill of skills) {
    if (skill.image) skillImages[skill.id] = skill.image;
}
---

<Layout
    title="Achievements | Fathy Rashad"
    description="Fathy Rashad's achievements, milestones, and bucket list — from hacking at 11 to co-founding startups, speaking at 20+ events, and diving with sharks."
>
    <Grid classes="py-40">
        <GridBox desktopFull>
            <SectionContent title="Achievements" classes="!px-0">
                <p>
                    A collection of Fun AI-generated achievement badges based on milestones and achievements throughout my journey in tech,
                    academia, and community building. From starting to code at 11 to co-founding
                    venture-backed startups, here's a visual representation of my progress.
                </p>
            </SectionContent>

            <div class="my-12">
                <AchievementGrid achievements={achievements} metrics={metrics} skillImages={skillImages} client:load />
            </div>
        </GridBox>
    </Grid>
</Layout>
